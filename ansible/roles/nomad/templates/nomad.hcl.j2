# Nomad Configuration File
# Generated by Ansible

data_dir  = "{{ nomad_data_dir }}"
bind_addr = "{{ ansible_default_ipv4.address }}"

log_level            = "{{ nomad_log_level }}"
log_include_location = {{ nomad_log_include_location | lower }}
log_file             = "{{ nomad_log_file }}"
enable_debug         = {{ nomad_enable_debug | lower }}

{% if nomad_telemetry_enabled %}
telemetry {
  publish_allocation_metrics = true
  publish_node_metrics       = true
  prometheus_metrics         = {{ nomad_telemetry_prometheus_metrics | lower }}
}
{% endif %}

{% if nomad_server_enabled %}
server {
  enabled          = true
  bootstrap_expect = {{ nomad_server_bootstrap_expect }}
{% if nomad_cloud_auto_join_enabled %}

  server_join {
    retry_join = ["provider=aws tag_key={{ nomad_cloud_auto_join_tag_key }} tag_value={{ nomad_cloud_auto_join_tag_value }}"]
  }
{% endif %}
}
{% endif %}

{% if nomad_client_enabled %}
client {
  enabled           = true
  network_interface = "{{ ansible_default_ipv4.alias }}"
{% if nomad_client_servers | length > 0 %}

  server_join {
    retry_join = [
{% for server in nomad_client_servers %}
      "{{ server }}"{{ "," if not loop.last else "" }}
{% endfor %}
    ]
  }
{% elif nomad_cloud_auto_join_enabled %}

  server_join {
    retry_join = ["provider=aws tag_key={{ nomad_cloud_auto_join_tag_key }} tag_value={{ nomad_cloud_auto_join_tag_value }}"]
  }
{% endif %}
}
{% endif %}

{% if nomad_acl_enabled %}
acl {
  enabled = true
}
{% endif %}